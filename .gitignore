# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data (large / raw datasets shouldn't live in git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model checkpoints & results (usually too large for git)
model/checkpoints/
*.pt
*.pth
*.ckpt
results/plots/*.png

# Trained tokenizer artifacts (regenerable from scripts + data, not source)
baselines/bpe_model/
tokenizer/phonetic_model/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Env / secrets
.env

# Logs
*.log
wandb/